{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Hub",
  "version": "0.1.17",
  "identifier": "com.rokid.prism.hub",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; frame-src http://127.0.0.1:17171; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Prism Hub",
        "width": 720,
        "height": 620,
        "minWidth": 640,
        "minHeight": 540,
        "resizable": true,
        "backgroundColor": "#F7F7FA",
        "titleBarStyle": "Transparent"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/": "resources/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
